# ─── ZipRIGHT Backend — .dockerignore ───────────────────────────────────────
#
# Exclude dev artefacts, secrets, and large directories that are not needed
# at runtime. Keeps the Docker build context small and fast.
# ─────────────────────────────────────────────────────────────────────────────

# Python artefacts
__pycache__
__pycache__/**
*.py[cod]
*.pyo
*.pyd
*.egg-info
*.egg-info/**
.eggs
.eggs/**

# Virtual environments (must match both directory and contents on Windows)
venv
venv/**
.venv
.venv/**
env
env/**
.env
.env.*
*.local

# Environment / secrets — NEVER include in image
serviceAccountKey.json
*serviceaccount*.json
*service-account*.json
firebase-adminsdk*.json
firebase_key.json
*-key.json
*_key.json
firebase-applet-config.json
*applet-config*.json
*.pem
*.key

# Test code (not needed in image)
tests
tests/**
test.py
test_*.py
conftest.py
pytest.ini
.pytest_cache
.pytest_cache/**
.ruff_cache
.ruff_cache/**

# Dev / CI tooling
Makefile
.editorconfig
.github
.github/**
benchmark_results
benchmark_results/**
backups
backups/**
vendor
vendor/**

# Runtime-generated files (created fresh in each container)
uploads
uploads/**
storage
storage/**

# Logs
*.log
out*.txt

# Documentation & scratch
*.md
docs
docs/**
scratch
scratch/**
*.ipynb
