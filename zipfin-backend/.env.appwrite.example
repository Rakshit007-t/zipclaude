# Appwrite Backend Configuration Example
# Set these variables in .env to switch backend to Appwrite

DATABASE_PROVIDER=appwrite
AUTH_PROVIDER=appwrite
STORAGE_PROVIDER=appwrite

# Self-Hosted Appwrite Endpoint (or https://appwrite.zipright.in/v1 for Production)
APPWRITE_ENDPOINT=https://appwrite.zipright.in/v1
APPWRITE_PROJECT_ID=zipright-staging
APPWRITE_API_KEY=your_appwrite_server_secret_api_key_here
APPWRITE_DATABASE_ID=zipright-staging-db

# Storage Buckets
APPWRITE_STORAGE_BUCKET_PUBLIC=zipright-public
APPWRITE_STORAGE_BUCKET_COMMUNITY=zipright-community
APPWRITE_STORAGE_BUCKET_PRIVATE=zipright-private

# Allow self-signed SSL for local self-hosted docker dev
APPWRITE_SELF_SIGNED=true
