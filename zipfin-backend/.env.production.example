# ─── ZipRIGHT Backend — Production Environment Overrides ────────────────────
#
# Copy to .env on your production server or inject as container env vars.
# NEVER store actual secret values here — use your secrets manager.
# ─────────────────────────────────────────────────────────────────────────────

ENV=production
LOG_LEVEL=INFO

# Restrict CORS to production domain only
CORS_ALLOW_ORIGINS=https://zipright.ai,https://app.zipright.ai
PRODUCTION_CORS_ORIGIN=https://zipright.ai

# Production Firebase project
FIREBASE_STORAGE_BUCKET=zipright-prod.firebasestorage.app
FIREBASE_PROJECT_ID=zipright-prod
FIRESTORE_DATABASE_ID=(default)

# Inject from secrets manager (GCP Secret Manager, AWS Secrets Manager, etc.)
# Do NOT hardcode values here.
FIREBASE_WEB_API_KEY=__inject_from_secrets_manager__
FIREBASE_CREDENTIALS_JSON=__inject_from_secrets_manager__
REPLICATE_API_TOKEN=__inject_from_secrets_manager__
FIRECRAWL_API_KEY=__inject_from_secrets_manager__
RAZORPAY_KEY_ID=__inject_from_secrets_manager__
RAZORPAY_KEY_SECRET=__inject_from_secrets_manager__
RAZORPAY_WEBHOOK_SECRET=__inject_from_secrets_manager__

# Distributed Redis / GCP Memorystore with TLS
REDIS_URL=rediss://:__inject_from_secrets_manager__@prod-memorystore-host:6379/0
REDIS_TIMEOUT_SECONDS=2.0

# Gunicorn — scale with your container CPU allocation
# 1 vCPU → WEB_CONCURRENCY=3, 2 vCPU → 5, 4 vCPU → 9
WEB_CONCURRENCY=5
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000

# Sentry Error Monitoring (Production)
SENTRY_DSN=__inject_from_secrets_manager__
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=zipright-backend@1.0.0

