# ─── ZipRIGHT Backend — Staging Environment Overrides ───────────────────────
#
# Copy to .env on your staging server.
# Only variables that differ from defaults are listed here.
# ─────────────────────────────────────────────────────────────────────────────

ENV=staging
LOG_LEVEL=INFO

CORS_ALLOW_ORIGINS=https://staging.zipright.ai
PRODUCTION_CORS_ORIGIN=https://staging.zipright.ai

# Staging Firebase project (separate from production)
FIREBASE_STORAGE_BUCKET=zipright-staging.firebasestorage.app
FIREBASE_PROJECT_ID=zipright-staging
FIRESTORE_DATABASE_ID=(default)

# Credentials injected from your CI/CD secrets store
FIREBASE_WEB_API_KEY=
FIREBASE_CREDENTIALS_JSON=

# External APIs (can use same keys or staging-specific keys)
REPLICATE_API_TOKEN=
FIRECRAWL_API_KEY=

WEB_CONCURRENCY=2
