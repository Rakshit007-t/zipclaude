# ─── ZipRIGHT Backend — Staging Environment Overrides ───────────────────────
#
# Copy to .env on your staging server.
# Only variables that differ from defaults are listed here.
# ─────────────────────────────────────────────────────────────────────────────

ENV=staging
LOG_LEVEL=INFO

CORS_ALLOW_ORIGINS=https://staging.zipright.ai
PRODUCTION_CORS_ORIGIN=https://staging.zipright.ai

# Staging Firebase project (separate from production)
FIREBASE_STORAGE_BUCKET=zipright-staging.firebasestorage.app
FIREBASE_PROJECT_ID=zipright-staging
FIRESTORE_DATABASE_ID=(default)

# Credentials injected from your CI/CD secrets store
FIREBASE_WEB_API_KEY=
FIREBASE_CREDENTIALS_JSON=

# External APIs (can use same keys or staging-specific keys)
REPLICATE_API_TOKEN=
FIRECRAWL_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Distributed Redis (Azure Managed Redis / Redis Cluster)
# Recommended: discrete variables (avoids URL delimiter/Base64 encoding corruption)
REDIS_HOST=redis-zipright-staging.centralindia.redis.azure.net
REDIS_PORT=10000
REDIS_USERNAME=default
REDIS_PASSWORD=__inject_primary_access_key_from_secrets_manager__
REDIS_SSL=true
REDIS_CLUSTER_MODE=true

# Alternative single-URL connection string (for local/testing or legacy setups)
# REDIS_URL=rediss://default:__key__@redis-zipright-staging.centralindia.redis.azure.net:10000/0
REDIS_TIMEOUT_SECONDS=2.0

WEB_CONCURRENCY=2

# Sentry Error Monitoring (Staging)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_RELEASE=zipright-backend@1.0.0

