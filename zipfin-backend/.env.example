# ─── ZipRIGHT Backend — Environment Variables Reference ─────────────────────
#
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
#
# ── Application ──────────────────────────────────────────────────────────────

# Environment name. Controls logging format, Swagger UI visibility, etc.
# Values: development | staging | production
ENV=development

# Log verbosity. Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Server bind address and port
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Number of Gunicorn worker processes (default: auto-scaled to CPU count)
# WEB_CONCURRENCY=4

# ── Security & Secrets ───────────────────────────────────────────────────────

# Secret key required for operator-level wallet credit calls
WALLET_TOPUP_SECRET=generate_a_strong_random_secret_here

# Payment Provider Secrets (server-side only)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins (e.g. https://zipright.ai,https://app.zipright.ai)
# Set to explicit origins; wildcards are rejected in production
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Custom regex for allowed origins (leave blank in production)
# CORS_ALLOW_ORIGIN_REGEX=

# Production frontend origin — always added to the whitelist
PRODUCTION_CORS_ORIGIN=https://zipright.ai

# ── External API Keys ─────────────────────────────────────────────────────────

# Google Gemini API key (for styling and recommendation reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Replicate.com (CatVTON cloud inference)
REPLICATE_API_TOKEN=your_replicate_token_here

# InsightFace API (face detection in try-on)
INSIGHTFACE_API_KEY=your_insightface_key_here

# Firecrawl (web scraping for product import)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ── Firebase ──────────────────────────────────────────────────────────────────

# Firebase Web API Key (required for Identity Toolkit REST authentication)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Storage bucket name (without gs:// prefix)
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Firestore database ID (use "(default)" or your specific database ID)
FIRESTORE_DATABASE_ID=(default)

# OPTION A — Full service account JSON as a single escaped string (preferred for secrets managers)
FIREBASE_CREDENTIALS_JSON=

# OPTION B — Discrete service account fields
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# OPTION C — Path to a service account key file (local dev only, never in Docker)
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# OPTION D — Use GOOGLE_APPLICATION_CREDENTIALS (Cloud Run, GKE workload identity)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ── Gunicorn Tuning ───────────────────────────────────────────────────────────

# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_LOG_LEVEL=info

# ── Distributed State & Background Jobs (Phase 2) ───────────────────────────

# Redis connection URL for shared rate limiting, account lockout, and background job queues.
# In local development, if left blank, in-process Redis emulation (fakeredis) is used automatically.
# Production example: redis://:password@10.0.0.4:6379/0
REDIS_URL=
REDIS_TIMEOUT_SECONDS=2.0

# Virtual Try-On Queue & GPU Concurrency Protection
# Maximum concurrent GPU jobs across all backend workers (prevents GPU VRAM OOM on RTX 3050)
TRYON_MAX_CONCURRENT_JOBS=2

# Maximum retries for transient errors (network timeouts, engine connection drops)
TRYON_MAX_RETRIES=2

# Job timeout before stale recovery marks job as failed (in seconds)
TRYON_JOB_TIMEOUT_SECONDS=600

# Maximum active (queued/running) try-on jobs per user to prevent queue starvation
TRYON_USER_MAX_ACTIVE_JOBS=2
