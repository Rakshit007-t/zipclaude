rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwnerEvent() {
      return request.auth != null
             && request.resource.data.userId == request.auth.uid;
    }

    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /recommendation_generated_events/{eventId} {
      allow create: if isOwnerEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /recommendation_viewed_events/{eventId} {
      allow create: if isOwnerEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /recommendation_accepted_events/{eventId} {
      allow create: if isOwnerEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /recommendation_rejected_events/{eventId} {
      allow create: if isOwnerEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /recommendation_feedback_events/{eventId} {
      allow create: if isOwnerEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /product_purchased_events/{eventId} {
      allow create: if isOwnerEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /size_exchanged_events/{eventId} {
      allow create: if isOwnerEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /size_returned_events/{eventId} {
      allow create: if isOwnerEvent();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /brand_fit_insights/{brandId} {
      allow read, write: if isAdmin();
    }

    match /public/{doc=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
