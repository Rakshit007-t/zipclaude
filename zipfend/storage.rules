rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function imageUnderFiveMb() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /profiles/{uid}.jpg {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && imageUnderFiveMb();
    }
    // Banner uploads use a deterministic owner-only path as well. Keeping this
    // separate prevents a client from writing arbitrary objects under /profiles.
    match /banners/{uid}.jpg {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && imageUnderFiveMb();
    }
    match /private/{uid}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
