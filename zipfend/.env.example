# ZipRIGHT Frontend Environment Variables Template
# Copy this file to .env and populate with your environment values.
# NEVER commit .env to version control.

# Backend API endpoint URL (FastAPI)
VITE_API_URL=http://127.0.0.1:8000

# Firebase Client Configuration (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIRESTORE_DATABASE_ID=ai-studio-b0abadf0-fee1-4a8b-ad1b-c9b670ea63a7

# Authentication options
VITE_ENABLE_PHONE_AUTH=false
VITE_PASSWORD_RESET_CONTINUE_URL=https://app.zipright.ai/#/login?passwordReset=complete

# Payment Gateway (Public Client Key ID only - NEVER put key secret here)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
