# .env.example
VITE_API_URL=http://127.0.0.1:8000
# Firebase console → Project settings → Storage bucket. For the configured
# project this is [REDACTED_HISTORICAL_PROJECT].firebasestorage.app.
VITE_FIREBASE_STORAGE_BUCKET=
# In production, phone auth is automatically enabled and requires Firebase Phone
# Authentication. Set this only to exercise real SMS auth during development.
VITE_ENABLE_PHONE_AUTH=false
# Optional. Set to your authorized ZipRIGHT domain, including the hash route.
VITE_PASSWORD_RESET_CONTINUE_URL=https://app.zipright.ai/#/login?passwordReset=complete
RAZORPAY_KEY_ID=
